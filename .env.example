# Copy to .env and fill in. Never commit .env.

# Google AI Studio key (free tier) for turning-point labels. Optional: without it videos have no labels.
GEMINI_API_KEY=

# Telegram bot from @BotFather, and the numeric chat id that is allowed to approve.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Path to the OAuth "Desktop app" client secret JSON downloaded from Google Cloud Console.
# Relative paths are resolved from the project root, e.g. tokens/client_secret.json
YT_CLIENT_SECRET_FILE=

# Instagram professional account id and a long-lived token with instagram_content_publish.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Optional: Facebook Page id for Page Reels (config facebook.enabled must be true).
FB_PAGE_ID=
