# Copy to .env and fill in what you have. Never commit .env. Every variable is optional:
# anything missing falls back to dry-run / dashboard-only, and `python run.py doctor` reports it.
# This list is exactly what the code reads (pipeline/config.py SECRET_NAMES; tests/test_env_example.py checks).

# Gemini API key for the 2-4 word turning-point labels; create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram bot token for approvals; create a bot with @BotFather (/newbot) and copy the token it gives you
TELEGRAM_BOT_TOKEN=

# Numeric chat id allowed to approve; message your bot, then read message.chat.id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Path to the YouTube OAuth "Desktop app" client JSON; download it from Google Cloud Console > Credentials (e.g. tokens/client_secret.json)
YT_CLIENT_SECRET_FILE=

# Instagram professional account id; read it with GET /{page-id}?fields=instagram_business_account in the Graph API Explorer
IG_USER_ID=

# Long-lived Facebook PAGE access token (also used for optional FB Page Reels); from the Graph API Explorer / your Meta app
IG_ACCESS_TOKEN=

# Facebook Page id for optional Page Reels (needs facebook.enabled: true in config.yaml); shown in the Page's About section
FB_PAGE_ID=
