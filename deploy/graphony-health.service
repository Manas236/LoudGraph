[Unit]
Description=Graphony: token, disk, pool and insights checks
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/graphony
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/graphony/.venv/bin/python -m pipeline health
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=2h
